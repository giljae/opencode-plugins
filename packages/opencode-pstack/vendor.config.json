{
  "upstream": {
    "repo": "https://github.com/cursor/plugins",
    "trigger": "versionFile",
    "branch": "main",
    "versionFile": "pstack/plugin.json"
  },
  "include": [
    { "from": "pstack/skills", "to": "skills" },
    { "from": "pstack/agents", "to": "agents" },
    { "from": "pstack/docs", "to": "docs" },
    { "from": "pstack/README.md", "to": "README.upstream.md" },
    { "from": "pstack/LICENSE", "to": "LICENSE.upstream" },
    { "from": "pstack/plugin.json", "to": "upstream-plugin.json" }
  ],
  "exclude": ["pstack/automations", "pstack/assets"],
  "dest": "vendor/pstack",
  "manifestField": "pstack"
}
